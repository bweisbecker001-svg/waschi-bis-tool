Options -Indexes
RewriteEngine On

# STRATO PHP API
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

# Vorhandene lokale Dateien und Ordner direkt ausliefern
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Uebergang: noch nicht lokal migrierte Bilder aus dem bisherigen Vercel-Bestand laden
RewriteRule ^assets/(.*)$ https://waschi-ekdq613p6-bernd-9907.vercel.app/assets/$1 [R=302,L,NE]
RewriteRule ^favicon\.ico$ https://waschi-ekdq613p6-bernd-9907.vercel.app/favicon.ico [R=302,L,NE]

# Textdateien komprimieren, falls mod_deflate verfuegbar ist
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser-Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 6 hours"
  ExpiresByType application/javascript "access plus 6 hours"
  ExpiresByType text/javascript "access plus 6 hours"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:webp|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=21600"
  </FilesMatch>
  <FilesMatch "\.(?:html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
