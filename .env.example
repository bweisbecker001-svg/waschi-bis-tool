# Nur auf dem Server / beim Hosting setzen. Niemals in index.html eintragen.
BLIZZARD_CLIENT_ID=deine_blizzard_api_client_id
BLIZZARD_CLIENT_SECRET=dein_blizzard_api_client_secret

# Warcraft Logs API v2 - Client Credentials fuer oeffentliche Logs
WARCRAFTLOGS_CLIENT_ID=deine_warcraftlogs_client_id
WARCRAFTLOGS_CLIENT_SECRET=dein_warcraftlogs_client_secret
